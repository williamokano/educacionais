    {"texto": "[excited] Esse ar quente na sua sala [leve] vem da rua. [leve] Onde tá fazendo _2 graus_.", "duracao": 4.2, "cena": {"cenario": "ciclo", "inverno": 1, "etapa": 10, "sentido": -1, "calorFora": -1, "camera": {"de": "split-dentro", "para": "casa"}, "personagens": [{"id": "zeca", "acao": "sentado+relaxado", "expressao": "sorriso", "pos": [-2.65, 0.05], "rot": 1.15, "fala": false, "cobertor": 1}], "cartoes": [{"tipo": "medida", "texto": "RUA: 2 °C", "cor": "#3b9de8", "x": 130, "y": 40, "trecho": 2}], "ambiencia": {"som": "vento", "volume": 0.3}, "sfx": [{"som": "sopro", "trecho": 0, "volume": 0.6}]}},
    {"texto": "Parece impossível. [leve] Mas é o mesmo ar-condicionado [leve] rodando ao contrário.", "duracao": 3.6, "cena": {"cenario": "ciclo", "inverno": 1, "etapa": 10, "sentido": -1, "calorFora": -1, "camera": {"de": "split-parede", "para": "split-fora"}, "personagens": [{"id": "zeca", "acao": "sentado+relaxado", "expressao": "sorriso", "pos": [-2.65, 0.05], "rot": 1.15, "fala": false, "cobertor": 1}]}},
